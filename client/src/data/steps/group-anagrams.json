{
  "schemaVersion": 1,
  "problemId": "group-anagrams",
  "solutionId": "char-count-key",
  "title": "Hash map keyed by character counts",
  "language": "python",
  "complexity": { "time": "O(n\u00b7k)", "space": "O(n\u00b7k)" },
  "footnotes": [
    {
      "id": 1,
      "line": 3,
      "text": "A fixed 26-slot count array instead of sorting the word: counting is O(k), sorting is O(k log k). Same canonical key, cheaper to build.",
      "step": 2
    },
    {
      "id": 2,
      "line": 6,
      "text": "tuple(count), never the list itself \u2014 dict keys must be hashable, and lists aren't. Freezing the counts is what makes them usable as a key.",
      "step": 2
    },
    {
      "id": 3,
      "line": 9,
      "text": "This append runs whether the bucket was just created or already existed \u2014 both branches converge here. groups.setdefault(key, []).append(word) collapses three lines into one.",
      "step": 5
    }
  ],
  "code": [
    "def groupAnagrams(strs):",
    "    groups = {}",
    "    for word in strs:",
    "        count = [0] * 26",
    "        for ch in word:",
    "            count[ord(ch) - ord('a')] += 1",
    "        key = tuple(count)",
    "        if key not in groups:",
    "            groups[key] = []",
    "        groups[key].append(word)",
    "    return list(groups.values())"
  ],
